{
  "_comment": "历史代理字段参考，不自动读取。请通过环境管理器配置；当前 EnvironmentBackend 不消费 rules 或 username/password 自动认证字段，见 settings/README.md。",

  "enabled": false,

  "default": {
    "type": "http",
    "_type_options": ["direct", "http", "https", "socks4", "socks5"],
    "host": "127.0.0.1",
    "port": 8080,
    "username": null,
    "password": null
  },

  "rules": [
    {
      "match": { "host": "*.example.com" },
      "proxy": { "type": "socks5", "host": "127.0.0.1", "port": 1080 }
    },
    {
      "match": { "url_regex": "^https://api\\.target\\.com/" },
      "proxy": { "type": "direct" }
    }
  ],

  "fallback_on_failure": true,
  "no_proxy_for": ["localhost", "127.0.0.1", "::1"]
}
